{
  // Type-check project for `next build` only (next.config.ts `typescript.tsconfigPath` when
  // NODE_ENV=production). The container image context has no test code (.dockerignore drops e2e/ and
  // scripts/*.mts, keeping only the two maintenance CLIs scripts/repair-github-identity.mts and
  // scripts/transfer-legacy-ownership.mts for the markdoc-maint tools image built with --target build),
  // so everything test-only is excluded here, and the scripts/**/*.mts exclude is what keeps those two
  // CLIs out of the production type-check; `npm run typecheck` (tsc -p tsconfig.json) and the editor
  // still cover all of it. Because this file `extends`, Next never rewrites it.
  "extends": "./tsconfig.json",
  "exclude": [
    "node_modules",
    "playwright.config.ts",
    "e2e/**",
    "scripts/**/*.mts",
    "**/*.test.ts",
    "**/*.test.tsx",
    "vitest.config.*",
    "vitest.setup.ts"
  ]
}
