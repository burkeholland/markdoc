# Copy to .env.local for local development.

# Required. Random string, e.g. `openssl rand -base64 32`.
AUTH_SECRET=change-me-to-a-long-random-string

# GitHub OAuth App (Settings > Developer settings > OAuth Apps).
# Callback URL: http://<machine-name>:3000/api/auth/callback/github (use the stable origin you open)
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Development only: allow signing in with any handle (no GitHub needed). Never enable in production.
AUTH_DEV_LOGIN=1

# Test environments only: adds a "Try the demo account" button that signs in as a fixed, seeded
# demo user (markdoc-demo). Requires NODE_ENV=development or test; the server refuses to start if this
# is set in production, and the VM deploy rejects an env file that contains it.
MARKDOC_DEMO_AUTH=

# Development only: a personal GitHub token used for gists/repos when signed in with the dev login.
# `gh auth token` prints one. Never commit it.
GITHUB_TOKEN=

# Postgres connection string. Leave empty to use an embedded PGlite database in .data/pglite.
DATABASE_URL=

# Optional: where the embedded database stores its files.
PGLITE_DATA_DIR=.data/pglite

# Optional in development: private Azure Blob container URL for video uploads. Required in production;
# the app's managed identity needs Storage Blob Data Contributor access to the container.
MARKDOC_VIDEO_CONTAINER_URL=

# Optional local video storage root. Defaults to .data/videos.
MARKDOC_VIDEO_DIR=

# Optional canonical public origin for links returned by MCP tools (set this behind a reverse proxy).
# Use a bare origin such as https://docs.example.com; paths, credentials, queries, and fragments fail startup.
# Remote MCP REST calls never trust forwarding headers: the custom server uses its loopback listener.
MARKDOC_URL=

# Optional internal origin for remote MCP REST callbacks. Set this only when Markdoc is not started
# through the custom server and cannot be reached at 127.0.0.1:$PORT. This must also be a bare origin.
MARKDOC_INTERNAL_URL=

# Optional: enables GET /api/admin/backup (hot backup of the embedded database for
# scripts/live/snapshot-data.ps1). Any long random string; keep it out of git. See RESUME.md.
BACKUP_TOKEN=

# Optional: how often automatic versions are captured while editing (milliseconds).
AUTO_VERSION_INTERVAL_MS=600000

# Optional: where sibling checkouts live (the live worktree, its data dir, the Tools team's load gate).
# Defaults to the parent directory of this repo. See scripts/lib/factory-root.mjs.
FACTORY_ROOT=

# Comma-separated words that must never appear in the tree; the factory sets this.
# src/app/confidential.test.ts skips when it is empty.
CONFIDENTIAL_WORDS=
