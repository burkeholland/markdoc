{
  "name": "markdoc",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx server/index.ts",
    "dev:port": "tsx scripts/dev-port.mts",
    "build": "next build && node scripts/precompress-static.mjs && node scripts/build-server.mjs",
    "start": "cross-env NODE_ENV=production node dist/server.mjs",
    "start:local": "cross-env NODE_ENV=production MARKDOC_PRODUCTION_PGLITE=local-rehearsal-only PORT=3900 PGLITE_DATA_DIR=.data/pglite-prod-smoke AUTH_SECRET=local-production-smoke-secret-not-for-real-use AUTH_DEV_LOGIN=force node dist/server.mjs",
    "smoke": "tsx scripts/smoke.mts",
    "seed:burke-scale": "tsx scripts/seed-burke-scale.mts",
    "soak:collab": "tsx scripts/collab-soak.mts",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:fuzz": "cross-env FUZZ_DOCS=1500 vitest run src/editor/markdown/incremental.test.ts --testTimeout=120000",
    "test:github": "vitest run src/server/publish-github.integration.test.ts",
    "test:e2e": "playwright test",
    "posttest:e2e": "tsx scripts/e2e-cleanup.mts",
    "tsconfig:revert": "tsx scripts/tsconfig-churn.ts",
    "db:generate": "drizzle-kit generate",
    "build:server": "node scripts/build-server.mjs",
    "resume-check": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/live/resume-check.ps1",
    "repair:github-identity": "tsx scripts/repair-github-identity.mts",
    "transfer:legacy-ownership": "tsx scripts/transfer-legacy-ownership.mts",
    "repair:imported-ystate": "tsx scripts/repair-imported-ystate.mts",
    "domain:preflight": "tsx scripts/custom-domain-preflight.mts",
    "dependency:preflight": "node --no-warnings --experimental-strip-types scripts/dependency-policy-preflight.mts",
    "release:verify": "tsx scripts/release-verify.mts",
    "mcp": "node mcp/server.mjs",
    "mcp:smoke": "node scripts/mcp-smoke.mjs"
  },
  "dependencies": {
    "@auth/drizzle-adapter": "^1.11.3",
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.0",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/search": "^6.7.1",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.9",
    "@electric-sql/pglite": "^0.5.7",
    "@hocuspocus/provider": "^4.6.0",
    "@hocuspocus/server": "^4.6.0",
    "@lezer/common": "^1.5.2",
    "@lezer/highlight": "^1.2.3",
    "@modelcontextprotocol/sdk": "^1.31.0",
    "@next/env": "^16.3.6",
    "@octokit/rest": "^22.0.1",
    "clsx": "^2.1.1",
    "diff": "^9.0.0",
    "drizzle-orm": "^0.45.2",
    "fast-diff": "^1.3.0",
    "jose": "^6.2.10",
    "lib0": "^0.2.117",
    "lowlight": "^3.3.0",
    "lucide-react": "^1.34.0",
    "mdast-util-from-markdown": "^2.0.3",
    "mdast-util-frontmatter": "^2.0.1",
    "mdast-util-gfm": "^3.1.0",
    "micromark-extension-frontmatter": "^2.0.0",
    "micromark-extension-gfm": "^3.0.0",
    "nanoid": "^6.0.1",
    "next": "16.3.6",
    "unicode-segmenter": "0.17.3",
    "next-auth": "^5.0.0-beta.32",
    "node-diff3": "^3.2.1",
    "pg": "^8.23.0",
    "playwright-core": "^1.62.1",
    "prosemirror-commands": "^1.7.2",
    "prosemirror-dropcursor": "^1.8.3",
    "prosemirror-gapcursor": "^1.4.1",
    "prosemirror-history": "^1.5.0",
    "prosemirror-inputrules": "^1.5.1",
    "prosemirror-keymap": "^1.2.3",
    "prosemirror-model": "^1.25.11",
    "prosemirror-schema-list": "^1.5.1",
    "prosemirror-state": "^1.4.4",
    "prosemirror-tables": "^1.8.5",
    "prosemirror-transform": "^1.12.0",
    "prosemirror-view": "^1.42.3",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "rehype-highlight": "^7.0.2",
    "rehype-parse": "^9.0.1",
    "rehype-remark": "^10.0.1",
    "rehype-sanitize": "^6.0.0",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "unified": "^11.0.5",
    "ws": "^8.21.3",
    "y-codemirror.next": "^0.3.6",
    "y-indexeddb": "^9.0.12",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.32",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/diff": "^7.0.2",
    "@types/mdast": "^4.0.4",
    "@types/node": "^22.20.1",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19.2.5",
    "@types/ws": "^8.18.1",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^30.0.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "$esbuild"
    },
    "concurrently": {
      "shell-quote": "1.11.0"
    }
  },
  "type": "module"
}
